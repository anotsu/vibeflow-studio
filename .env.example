# ============================================
# VibeFlow Studio — Environment Variables
# ============================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/vibeflow_studio?schema=public"

# Redis (for BullMQ task queues)
REDIS_URL="redis://localhost:6379"

# GitHub
GITHUB_TOKEN="ghp_your_github_personal_access_token"
GITHUB_WEBHOOK_SECRET="your_webhook_secret"

# Anthropic (Claude)
ANTHROPIC_API_KEY="sk-ant-your_anthropic_api_key"

# Coolify
COOLIFY_API_URL="https://coolify.your-domain.com"
COOLIFY_API_TOKEN="your_coolify_api_token"

# Terminal WebSocket Server
TERMINAL_WS_PORT=3001

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# Encryption key for stored credentials (32 bytes hex)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
